# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA commite o arquivo ".env" (ele contém segredos).

PORT=3000

# Chave da AllowPay — fica só no servidor, nunca no HTML/JS público.
ALLOWPAY_API_KEY=allow_apikey_ekls4xtcgap
ALLOWPAY_BASE_URL=https://allow-gi0i.onrender.com

# Segredo usado para assinar/validar o webhook (recomendado). Gere um valor aleatório forte.
ALLOWPAY_WEBHOOK_SECRET=troque_por_um_segredo_forte

# URL pública e HTTPS deste servidor (ex: https://sualoja.com). Necessária para o webhook
# funcionar — a AllowPay recusa URLs internas/privadas. Deixe em branco para usar só polling.
PUBLIC_URL=
